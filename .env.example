# Copy this file to .env and replace the placeholder. Never commit .env.
POSTGRES_DB=securevault
POSTGRES_USER=securevault
POSTGRES_PASSWORD=replace-with-a-long-random-value

# Port the application is published on, bound to localhost only.
WEB_PORT=3000

# Encrypts two-factor (TOTP) secrets at rest: 32 random bytes, base64. This value is for local
# development only and the prod profile refuses to start with it. Make your own with:
#   openssl rand -base64 32
SECUREVAULT_MFA_KEY=SJyWsaORt44YzvGk/jtVWDv1ff7PxRxEGZZ6b6DQpxM= # gitleaks:allow
